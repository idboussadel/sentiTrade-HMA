*.ipynb_checkpoints

# pyenv
.python-version

# mypy
.mypy_cache/
.dmypy.json

# VS Code
.vscode/

# Environments
.env
.venv
env/
venv/
ENV/
lenv/

# Logs
logs/
*.log

# Ignore everything in lightning_logs except .gitkeep
lightning_logs/

# Ignore everything in figures except .gitkeep
figures/*
!figures/.gitkeep

# Ignore egg-info
*.egg-info/

