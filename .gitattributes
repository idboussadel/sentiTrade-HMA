# Git LFS - Only for heavy data in /data and /models

# Data directory - track large files with LFS
data/**/*.csv filter=lfs diff=lfs merge=lfs -text
data/**/*.pkl filter=lfs diff=lfs merge=lfs -text
data/**/*.pickle filter=lfs diff=lfs merge=lfs -text
data/**/*.npz filter=lfs diff=lfs merge=lfs -text

# Models directory - track large model files with LFS
models/**/*.ckpt filter=lfs diff=lfs merge=lfs -text
models/**/*.safetensors filter=lfs diff=lfs merge=lfs -text
models/**/*.pth filter=lfs diff=lfs merge=lfs -text
models/**/*.pt filter=lfs diff=lfs merge=lfs -text
models/**/*.bin filter=lfs diff=lfs merge=lfs -text
models/**/*.pkl filter=lfs diff=lfs merge=lfs -text

# Keep small config files normal (not LFS)
!data/**/*.json filter=lfs diff=lfs merge=lfs -text
!models/**/*.json filter=lfs diff=lfs merge=lfs -text
!configs/** filter=lfs diff=lfs merge=lfs -text